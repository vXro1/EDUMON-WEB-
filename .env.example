# Copia este archivo como ".env.local" (no se versiona) y ajusta lo que necesites.

# Destino del proxy del servidor de desarrollo de Vite (npm run dev) para
# /api, /uploads, /static y /socket.io. Por defecto el backend local
# (Backend/: npm run dev, puerto 4000). No apuntes a producción: todo lo que
# hagas en local escribiría datos reales.
VITE_API_PROXY_TARGET=http://localhost:4000

# Base de la API que usa el navegador. Sin definir = "/api" (pasa por el proxy
# de arriba en desarrollo y por nginx en producción). Déjala comentada: una
# cadena vacía NO equivale a "/api".
# VITE_API_URL=/api
