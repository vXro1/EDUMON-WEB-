# Copiar a .env.local (ignorado por git) y ajustar. Nunca poner llaves ni secretos aquí.

# Backend al que apunta el proxy de Vite en desarrollo (/api, /uploads, /static, /socket.io).
# Sin valor se usa producción. Para la demo local: http://127.0.0.1:4100 (o :4000 con Docker).
VITE_BACKEND_URL=http://127.0.0.1:4100

# Base de la API en el navegador. Por defecto "/api" (mismo origen, pasa por el proxy o por nginx).
# VITE_API_URL=/api

# Muestra la etiqueta "Datos de demostración" en el panel de Edumon IA (impacto). Activar en la feria con el seed de demo.
VITE_MODO_DEMO=true

# Sesión de validación que se envía con cada 👍/👎 del chat, para separar las pruebas con usuarios reales.
VITE_IA_SESION_VALIDACION=feria-2026-10-21

# Notificaciones push (clave pública VAPID de Firebase; opcional en la demo).
# VITE_FIREBASE_VAPID_KEY=
